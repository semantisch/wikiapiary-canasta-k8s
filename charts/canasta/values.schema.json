{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["site"],
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryHost"],
      "properties": {
        "primaryHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^(localhost|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+)$"
        },
        "additionalHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "edge": {
          "type": "object",
          "properties": {
            "tlsHosts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
              }
            }
          }
        }
      }
    }
  }
}
